{
  "name": "dsh-plugin-ui-zoom",
  "version": "0.1.2",
  "description": "Whole-interface zoom for DeepSeek Harness: 70%–160% via Ctrl+wheel, the DSH shortcut center, or an inline pill — with content-width compensation so zooming out shows more text instead of a narrower strip.",
  "type": "module",
  "license": "MIT",
  "author": "1700563146",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1700563146/dsh-plugin-ui-zoom.git"
  },
  "homepage": "https://github.com/1700563146/dsh-plugin-ui-zoom#readme",
  "bugs": {
    "url": "https://github.com/1700563146/dsh-plugin-ui-zoom/issues"
  },
  "icon": "./icon.svg",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "zoom",
    "ui",
    "accessibility"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
